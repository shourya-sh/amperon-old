# Amperon Server Environment Variables
# =====================================

# Nexar API Credentials (for LIVE component pricing)
# Get your FREE API keys at: https://nexar.com/api
# - Sign up for free (1000 queries/month included)
# - Create an application to get Client ID and Secret
# - This gives you real-time prices from 200+ distributors including:
#   Digi-Key, Mouser, Arrow, Newark, Farnell, and more!

NEXAR_CLIENT_ID=your_client_id_here
NEXAR_CLIENT_SECRET=your_client_secret_here

# Server Port (optional, defaults to 3001)
PORT=3001
